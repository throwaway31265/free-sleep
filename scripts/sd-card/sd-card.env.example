# Settings for patch_factory_image.sh.
# Copy to sd-card.env (ignored by git) and fill it in:  cp sd-card.env.example sd-card.env
# Anything left empty is asked for when the script runs (passwords are not echoed).

# Wi-Fi the Pod should join after the reset: 2.4 GHz, WPA2-Personal (8-63 character passphrase)
WIFI_SSID='YOUR_WIFI_SSID'
WIFI_PASSWORD=''

# New password for both root and rewt (the stock login users)
ROOT_PASSWORD=''

# Your SSH PUBLIC key file (.pub), installed as /etc/ssh/authorized_keys
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"

# SSH access. Key login as rewt always works.
ALLOW_ROOT_SSH=false              # true = also allow root over SSH (stock firmware only allows rewt)
ALLOW_PASSWORD_SSH=false          # true = also allow password login over SSH (key login is enough for free-sleep)
KEEP_EXISTING_AUTHORIZED_KEYS=false   # true = keep keys already in the image's authorized_keys

# true = rewt can use sudo without a password (the free-sleep installer runs with sudo)
REWT_PASSWORDLESS_SUDO=true

# true = mask Eight Sleep's firmware updater and cloud services (INSTALLATION.md step 11).
# Keep this on: otherwise the Pod updates itself and the changes are lost.
MASK_UPDATE_SERVICES=true
