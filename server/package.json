{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "dotenv -e .env.pod -- node dist/server.js",
    "build": "tsc && npm run sentry:sourcemaps",
    "sentry:inject": "sentry-cli sourcemaps inject --org free-sleep --project server ./dist",
    "sentry:sourcemaps": "npm run sentry:inject && sentry-cli sourcemaps upload --org free-sleep --project server ./dist",
    "build:pr": "tsc && npm run sentry:inject",
    "dev": "MODE=dev dotenv -e .env.pod -- nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "dev:local": "dotenv -e .env.local -- nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "lint": "eslint src/",
    "migrate": "dotenv -e .env.pod -- npx prisma migrate dev --name ",
    "generate": "dotenv -e .env.pod -- npx prisma generate",
    "migrate:local": "dotenv -e .env.local -- npx prisma migrate dev --name ",
    "generate:local": "dotenv -e .env.local -- npx prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "volta": {
    "node": "24.11.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sentry/node": "^11.4.0",
    "binary-split": "^1.0.5",
    "bree": "^9.2.0",
    "cbor": "^10.0.12",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv-cli": "^11.0.0",
    "express": "^5.1.0",
    "lodash": "^4.17.0",
    "lowdb": "^7.0.1",
    "moment-timezone": "^0.6.5",
    "node-schedule": "^2.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.19.1",
    "@types/node-schedule": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "nodemon": "^3.1.0",
    "prisma": "6.19.3",
    "ts-essentials": "^10.2.1",
    "ts-node": "^10.9.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
